<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The app renders entirely in Compose, so this style only covers the frames before
      Compose draws: the cold-start window and activity transitions.

      It intentionally uses the Light Material parent with a white windowBackground
      because Light is the app's default theme (see AppTheme.LIGHT).
    -->
    <style name="Theme.ScrapUncle" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

</resources>
